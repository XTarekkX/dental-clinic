# Copy to .env.properties (gitignored) and fill in real values.
# Loaded automatically by Spring Boot via spring.config.import in application.yml.
# Real environment variables with these same names take precedence.

DB_URL=jdbc:postgresql://localhost:5432/dental_clinic
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Public base URL of this API (used to build X-ray file URLs)
APP_BASE_URL=http://localhost:8080

# Location of the JWT signing key (must not be inside the repo)
JWT_PRIVATE_KEY_LOCATION=file:./config/keys/private.pem
